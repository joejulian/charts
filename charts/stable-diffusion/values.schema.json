{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "resources"
  ],
  "properties": {
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "enum": [
                      "0",
                      "0Gi",
                      "0Mi",
                      "0m"
                    ]
                  }
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "enum": [
                      "0",
                      "0Gi",
                      "0Mi",
                      "0m"
                    ]
                  }
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "enum": [
                      "0",
                      "0Gi",
                      "0Mi",
                      "0m"
                    ]
                  }
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "enum": [
                      "0",
                      "0Gi",
                      "0Mi",
                      "0m"
                    ]
                  }
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ]
            }
          }
        }
      }
    }
  }
}
