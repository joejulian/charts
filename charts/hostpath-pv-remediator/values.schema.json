{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "controller": {
      "type": "object",
      "required": [
        "eligibleNodeSelector",
        "conditionType",
        "conditionMessageRegexp",
        "maxHeartbeatAge",
        "maxFutureClockSkew",
        "triggerAfter",
        "pollInterval",
        "drainTimeout",
        "verificationTimeout",
        "stabilization",
        "recycleTimeout",
        "allowEmptyDir",
        "metricsBindAddress",
        "healthProbeBindAddress"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "argsOverride": {
          "type": "array",
          "items": { "type": "string" }
        },
        "eligibleNodeSelector": { "type": "string", "minLength": 1 },
        "conditionType": { "type": "string", "minLength": 1 },
        "conditionMessageRegexp": { "type": "string", "minLength": 1 },
        "maxHeartbeatAge": { "$ref": "#/definitions/duration" },
        "maxFutureClockSkew": { "$ref": "#/definitions/duration" },
        "triggerAfter": { "$ref": "#/definitions/duration" },
        "pollInterval": { "$ref": "#/definitions/duration" },
        "drainTimeout": { "$ref": "#/definitions/duration" },
        "verificationTimeout": { "$ref": "#/definitions/duration" },
        "stabilization": { "$ref": "#/definitions/duration" },
        "recycleTimeout": { "$ref": "#/definitions/duration" },
        "allowEmptyDir": { "type": "boolean" },
        "metricsBindAddress": { "type": "string", "minLength": 1 },
        "healthProbeBindAddress": { "type": "string", "minLength": 1 }
      }
    },
    "leaderElection": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "remediation": {
      "type": "object",
      "required": ["enabled", "requireApproval", "leaseName", "leaseDurationSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requireApproval": { "type": "boolean" },
        "leaseName": { "type": "string", "minLength": 1, "maxLength": 63 },
        "leaseDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "repair": {
      "type": "object",
      "required": [
        "mountTarget",
        "expectedFSType",
        "expectedSource",
        "systemdUnit",
        "waitingThreshold",
        "activeDeadlineSeconds",
        "verifyTimeoutSeconds",
        "pollIntervalSeconds",
        "ttlSecondsAfterFinished"
      ],
      "properties": {
        "mountTarget": { "type": "string", "pattern": "^/[^\\n]*[^/]$" },
        "expectedFSType": { "type": "string", "pattern": "^[^[:space:]]+$" },
        "expectedSource": { "type": "string", "pattern": "^[^[:space:]]+$" },
        "systemdUnit": { "type": "string", "pattern": "^[^/[:space:]]+\\.mount$" },
        "waitingThreshold": { "type": "integer", "minimum": 1 },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "verifyTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "pollIntervalSeconds": { "type": "integer", "minimum": 1 },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "admissionPolicy": {
      "type": "object",
      "required": ["enabled", "jobControllerUsername"],
      "properties": {
        "enabled": { "type": "boolean" },
        "jobControllerUsername": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
    }
  },
  "required": ["image", "controller", "leaderElection", "remediation", "repair", "admissionPolicy"]
}
