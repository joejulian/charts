{
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
  ],
  labels: ["dependencies"],
  automergeType: "pr",
  platformAutomerge: false,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  rebaseWhen: "behind-base-branch",
  packageRules: [
    {
      matchManagers: ["github-actions"],
      automerge: true,
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      addLabels: ["automerge"],
    },
    {
      description: "OpenLDAP 2.7 requires an offline LMDB export/import migration",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/joejulian/container-images/openldap"],
      allowedVersions: "<2.7.0",
      automerge: false,
    },
    {
      matchManagers: ["helmv3"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      addLabels: ["automerge"],
    },
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)charts\\/[^/]+\\/Chart\\.ya?ml$/"],
      matchStrings: [
        "# renovate: image=(?<depName>[^\\s]+)\\nappVersion: [\"']?(?<currentValue>[^\"'\\n]+)[\"']?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)charts\\/[^/]+\\/values\\.ya?ml$/"],
      matchStrings: [
        "# renovate: image=(?<depName>[^\\s]+)\\n\\s*(?:tag|version):\\s*[\"']?(?<currentValue>[^\"'\\n]+)[\"']?(?:\\n\\s*digest:\\s*[\"']?(?<currentDigest>sha256:[a-f0-9]{64})[\"']?)?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)charts\\/[^/]+\\/templates\\/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: image=(?<depName>[^\\s]+)\\n\\s*image:\\s*[\"']?[^\\s\"']+:(?<currentValue>[^\\s\"']+)[\"']?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  postUpgradeTasks: {
    commands: [
      "./scripts/bump-chart.sh",
    ],
    fileFilters: [
      "charts/*/Chart.yaml",
    ],
    executionMode: "update",
  },
}
